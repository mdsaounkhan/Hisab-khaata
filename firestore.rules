rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /announcements/{announcementId} {
      // Anyone using the app can read system updates and notices
      allow read: if true;
      // Only saounonly@gmail.com can create, edit, or delete announcements
      allow write: if request.auth != null && (
        request.auth.token.email == 'saounonly@gmail.com' ||
        request.auth.token.email.lower() == 'saounonly@gmail.com'
      );
    }
  }
}
